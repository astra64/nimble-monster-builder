<form class="nmb-root" data-mode="{{mode}}" data-linked="true" autocomplete="off">
  <header class="nmb-header">
    <div class="nmb-title-row">
      <div class="nmb-title-fields">
        <input type="text" class="nmb-name" name="name" value="{{defaultName}}" aria-label="{{localize 'NMB.Builder.Fields.Name'}}">
        <input type="text" class="nmb-type" name="creatureType" placeholder="{{localize 'NMB.Builder.Fields.CreatureTypePlaceholder'}}" aria-label="{{localize 'NMB.Builder.Fields.CreatureType'}}">
      </div>
      <div class="nmb-seg-group" role="group" aria-label="{{localize 'NMB.Builder.Fields.Mode'}}">
        {{#each modes}}
        <button type="button" class="nmb-seg-btn {{#if active}}active{{/if}}" data-action="switchMode" data-mode="{{id}}" aria-pressed="{{active}}">{{localize label}}</button>
        {{/each}}
      </div>
    </div>

    <section class="nmb-card" aria-live="polite">
      <div class="nmb-stat"><span class="nmb-stat-label">{{localize "NMB.Builder.Chips.Level"}}</span><b class="nmb-stat-value" data-stat="level">-</b></div>
      <div class="nmb-stat"><span class="nmb-stat-label">{{localize "NMB.Builder.Chips.HP"}}</span><b class="nmb-stat-value" data-stat="hp">-</b></div>
      <div class="nmb-stat"><span class="nmb-stat-label">{{localize "NMB.Builder.Chips.Armor"}}</span><b class="nmb-stat-value" data-stat="armor">-</b></div>
      <div class="nmb-stat"><span class="nmb-stat-label">{{localize "NMB.Builder.Chips.Damage"}}</span><b class="nmb-stat-value" data-stat="damage">-</b></div>
      <div class="nmb-stat"><span class="nmb-stat-label">{{localize "NMB.Builder.Chips.SaveDC"}}</span><b class="nmb-stat-value" data-stat="saveDC">-</b></div>
      <div class="nmb-stat"><span class="nmb-stat-label">{{localize "NMB.Builder.Chips.CR"}}</span><b class="nmb-stat-value" data-stat="cr">-</b></div>
      <p class="nmb-card-note" data-summary hidden></p>
    </section>
  </header>

  <nav class="nmb-tabs">
    {{#each tabs}}
    <a class="nmb-tab {{#if active}}active{{/if}}" data-action="switchTab" data-tab="{{id}}">{{localize label}}{{#if badge}} <span class="nmb-badge" data-ability-count hidden></span>{{/if}}</a>
    {{/each}}
  </nav>

  <div class="nmb-panels">
    {{!-- Stats --}}
    <section class="nmb-panel {{#if tabs.0.active}}active{{/if}}" data-tab="stats">
      <div class="nmb-row">
        <label for="nmb-level">{{localize "NMB.Builder.Fields.Level"}}</label>
        <div class="nmb-inline">
          <select id="nmb-level" name="level" data-linked-only>
            {{#each levels}}<option value="{{value}}" {{#if selectedStandard}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <select name="hpLevel" data-unlinked-only aria-label="{{localize 'NMB.Builder.Fields.HpLevel'}}">
            {{#each levels}}<option value="{{value}}" {{#if selectedStandard}}selected{{/if}}>HP: {{label}}</option>{{/each}}
          </select>
          <select name="dmgLevel" data-unlinked-only aria-label="{{localize 'NMB.Builder.Fields.DamageLevel'}}">
            {{#each levels}}<option value="{{value}}" {{#if selectedStandard}}selected{{/if}}>Dmg: {{label}}</option>{{/each}}
          </select>
          <button type="button" class="nmb-link" data-action="toggleLink" data-for="standard"
                  aria-pressed="true" data-tooltip="{{localize 'NMB.Builder.Fields.LinkHint'}}">
            <i class="fa-solid fa-link"></i>
          </button>
        </div>
      </div>

      <div class="nmb-row" data-for="standard">
        <span class="nmb-label">{{localize "NMB.Builder.Fields.Armor"}}</span>
        <div>
          <div class="nmb-seg-group nmb-radios" role="radiogroup">
            {{#each armors}}
            <label class="nmb-seg"><input type="radio" name="armor" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{localize label}}</span></label>
            {{/each}}
          </div>
          <p class="nmb-hint">{{localize "NMB.Builder.Fields.ArmorHint"}}</p>
        </div>
      </div>

      <div class="nmb-row">
        <label for="nmb-size">{{localize "NMB.Builder.Fields.Size"}}</label>
        <select id="nmb-size" name="size">
          {{#each sizes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
    </section>

    {{!-- Attacks --}}
    <section class="nmb-panel {{#if tabs.1.active}}active{{/if}}" data-tab="attacks">
      <div class="nmb-attacks" data-attacks></div>
      <button type="button" class="nmb-add-attack" data-action="addAttack" data-for="standard">
        <i class="fa-solid fa-plus"></i> {{localize "NMB.Builder.Attack.Add"}}
      </button>

      <template data-attack-template>
        <details class="nmb-attack" open>
          <summary>
            <span class="nmb-attack-title" data-attack-title></span>
            <span class="nmb-attack-sub" data-attack-sub></span>
            <button type="button" class="nmb-attack-remove" data-action="removeAttack" data-for="standard"
                    aria-label="{{localize 'NMB.Builder.Attack.Remove'}}" data-tooltip="{{localize 'NMB.Builder.Attack.Remove'}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          </summary>
          <div class="nmb-attack-body">
            <div class="nmb-row">
              <label>{{localize "NMB.Builder.Attack.Name"}}</label>
              <input type="text" data-field="name" placeholder="{{localize 'NMB.Builder.Attack.NamePlaceholder'}}">
            </div>
            <div class="nmb-row">
              <span class="nmb-label" data-for="standard">{{localize "NMB.Builder.Attack.Count"}}</span>
              <span class="nmb-label" data-for="minion">{{localize "NMB.Builder.Fields.Range"}}</span>
              <div class="nmb-inline-controls">
                <div class="nmb-seg-group" role="radiogroup" data-for="standard">
                  {{#each counts}}
                  <label class="nmb-seg"><input type="radio" name="count-__ID__" data-field="count" value="{{this}}" {{#if @first}}checked{{/if}}><span>{{this}}×</span></label>
                  {{/each}}
                </div>
                <span class="nmb-label nmb-inline-label" data-for="standard">{{localize "NMB.Builder.Fields.Range"}}</span>
                <div class="nmb-seg-group" role="radiogroup">
                  <label class="nmb-seg"><input type="radio" name="range-__ID__" data-field="attackType" value="melee" checked><span>{{localize "NMB.Builder.Range.Melee"}}</span></label>
                  <label class="nmb-seg"><input type="radio" name="range-__ID__" data-field="attackType" value="range"><span>{{localize "NMB.Builder.Range.Ranged"}}</span></label>
                </div>
              </div>
            </div>
            <div class="nmb-row">
              <span class="nmb-label">{{localize "NMB.Builder.Fields.Die"}}</span>
              <div>
                <div class="nmb-seg-group nmb-radios" role="radiogroup">
                  {{#each dice}}
                  <label class="nmb-seg"><input type="radio" name="die-__ID__" data-field="die" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>
                  {{/each}}
                </div>
                <p class="nmb-hint" data-die-hint></p>
              </div>
            </div>
            <div class="nmb-row">
              <span class="nmb-label">{{localize "NMB.Builder.Fields.DamageType"}}</span>
              <div class="nmb-dtypes">
                {{#each damageGroups}}
                <div class="nmb-dtype-group {{#if singleRow}}nmb-dtype-group--row{{/if}}" style="--cols: {{cols}}">
                  <span class="nmb-dtype-group-label">{{localize label}}</span>
                  {{#each types}}
                  <label class="nmb-dtype" data-type="{{id}}"><input type="radio" name="type-__ID__" data-field="damageType" value="{{id}}" {{#if checked}}checked{{/if}}><span><i class="fa-solid {{icon}}"></i> {{localize label}}</span></label>
                  {{/each}}
                </div>
                {{/each}}
              </div>
            </div>
            <div class="nmb-row">
              <label>{{localize "NMB.Builder.Attack.Notes"}}</label>
              <input type="text" data-field="notes" placeholder="{{localize 'NMB.Builder.Attack.NotesPlaceholder'}}">
            </div>
            <p class="nmb-warn" data-attack-warn hidden></p>
          </div>
        </details>
      </template>
    </section>

    {{!-- Abilities --}}
    <section class="nmb-panel {{#if tabs.2.active}}active{{/if}}" data-tab="abilities">
      <p class="nmb-hint" data-for="standard">{{localize "NMB.Builder.Abilities.CostHint"}}</p>
      <p class="nmb-hint" data-for="minion">{{localize "NMB.Builder.Abilities.MinionNote"}}</p>

      <div class="nmb-ability-tools">
        <input type="search" data-ability-search placeholder="{{localize 'NMB.Builder.Abilities.Search'}}" aria-label="{{localize 'NMB.Builder.Abilities.Search'}}">
        <label class="nmb-check"><input type="checkbox" data-ability-selected-only> {{localize "NMB.Builder.Abilities.SelectedOnly"}}</label>
      </div>

      <ul class="nmb-abilities" data-abilities>
        {{#each abilities}}
        <li class="nmb-ability-row" data-ability-id="{{id}}" data-search="{{search}}">
          <label class="nmb-ability-main">
            <input type="checkbox" data-field="enabled">
            <span class="nmb-ability-name">{{name}}</span>
          </label>
          <span class="nmb-ability-text">{{text}}</span>
          <div class="nmb-seg-group nmb-ability-cost" data-for="standard" role="radiogroup" aria-label="{{localize 'NMB.Builder.Abilities.CostLabel'}}">
          <label class="nmb-seg"><input type="radio" name="cost-{{id}}" data-field="cost" value="hp"><span>{{localize "NMB.Builder.Abilities.CostHp"}}</span></label>
          <label class="nmb-seg"><input type="radio" name="cost-{{id}}" data-field="cost" value="damage"><span>{{localize "NMB.Builder.Abilities.CostDamage"}}</span></label>
          <label class="nmb-seg"><input type="radio" name="cost-{{id}}" data-field="cost" value="free" checked><span>{{localize "NMB.Builder.Abilities.CostFree"}}</span></label>
        </div>
        </li>
        {{/each}}
      </ul>

      <h3 class="nmb-subheading">{{localize "NMB.Builder.Abilities.CustomHeading"}}</h3>
      <div class="nmb-custom-abilities" data-custom-abilities></div>
      <button type="button" class="nmb-add-attack" data-action="addCustomAbility">
        <i class="fa-solid fa-plus"></i> {{localize "NMB.Builder.Abilities.AddCustom"}}
      </button>

      <template data-custom-ability-template>
        <div class="nmb-custom-ability is-on">
          <div class="nmb-custom-head">
            <input type="text" data-field="name" placeholder="{{localize 'NMB.Builder.Abilities.CustomName'}}" aria-label="{{localize 'NMB.Builder.Abilities.CustomName'}}">
            <button type="button" class="nmb-attack-remove" data-action="removeCustomAbility"
                    aria-label="{{localize 'NMB.Builder.Abilities.RemoveCustom'}}" data-tooltip="{{localize 'NMB.Builder.Abilities.RemoveCustom'}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
          <input type="text" data-field="text" placeholder="{{localize 'NMB.Builder.Abilities.CustomText'}}" aria-label="{{localize 'NMB.Builder.Abilities.CustomText'}}">
          <div class="nmb-seg-group nmb-ability-cost" data-for="standard" role="radiogroup" aria-label="{{localize 'NMB.Builder.Abilities.CostLabel'}}">
          <label class="nmb-seg"><input type="radio" name="ccost-__ID__" data-field="cost" value="hp"><span>{{localize "NMB.Builder.Abilities.CostHp"}}</span></label>
          <label class="nmb-seg"><input type="radio" name="ccost-__ID__" data-field="cost" value="damage"><span>{{localize "NMB.Builder.Abilities.CostDamage"}}</span></label>
          <label class="nmb-seg"><input type="radio" name="ccost-__ID__" data-field="cost" value="free" checked><span>{{localize "NMB.Builder.Abilities.CostFree"}}</span></label>
        </div>
        </div>
      </template>
    </section>

    {{!-- Misc --}}
    <section class="nmb-panel {{#if tabs.3.active}}active{{/if}}" data-tab="misc">
      <div class="nmb-row" data-for="standard">
        <label for="nmb-flunky">{{localize "NMB.Builder.Fields.Flunky"}}</label>
        <label class="nmb-check"><input id="nmb-flunky" type="checkbox" name="flunky"> {{localize "NMB.Builder.Fields.FlunkyHint"}}</label>
      </div>
      <div class="nmb-row">
        <label for="nmb-openSheet">{{localize "NMB.Builder.Fields.OpenSheet"}}</label>
        <label class="nmb-check"><input id="nmb-openSheet" type="checkbox" name="openSheet" checked> {{localize "NMB.Builder.Fields.OpenSheetHint"}}</label>
      </div>
    </section>
  </div>

  <footer class="nmb-footer">
    <button type="button" class="nmb-create" data-action="create" data-tooltip="{{localize 'NMB.Builder.CreateHint'}}">
      <i class="fa-solid fa-dragon"></i> {{localize "NMB.Builder.Create"}}
    </button>
  </footer>
</form>
